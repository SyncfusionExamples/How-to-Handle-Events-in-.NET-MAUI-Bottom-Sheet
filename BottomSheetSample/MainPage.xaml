<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BottomSheetSample.MainPage"
             xmlns:bottomSheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit">



        <bottomSheet:SfBottomSheet
        x:Name="weatherBottomSheet"
        StateChanged="WeatherBottomSheet_StateChanged">

        <bottomSheet:SfBottomSheet.Content>
                <Button Text="View Forecast"
                        Clicked="ViewForecast_Clicked"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
        </bottomSheet:SfBottomSheet.Content>
        <bottomSheet:SfBottomSheet.BottomSheetContent>

                <VerticalStackLayout
                Padding="20"
                Spacing="15">

                    <!-- Header -->
                    <Label Text="Today's Weather"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                    <!-- Summary -->
                    <Label Text="&#xe74a;" FontFamily="MauiMaterialAssets"
                       FontSize="50"
                       HorizontalOptions="Center"/>

                    <Label Text="28°C"
                       FontSize="36"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                    <Label Text="Sunny"
                       FontSize="18"
                       HorizontalOptions="Center"/>

                    <Label Text="Pull up for more details"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>

                    <!-- Detailed Forecast -->
                    <Border x:Name="forecastDetails"
                        IsVisible="False"
                        Stroke="#E0E0E0"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">

                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Humidity" />
                                <Label Grid.Column="1"
                                   Text="65%" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Wind Speed" />
                                <Label Grid.Column="1"
                                   Text="12 km/h" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="UV Index" />
                                <Label Grid.Column="1"
                                   Text="High" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Rain Chance" />
                                <Label Grid.Column="1"
                                   Text="10%" />
                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </bottomSheet:SfBottomSheet.BottomSheetContent>

        </bottomSheet:SfBottomSheet>

</ContentPage>
